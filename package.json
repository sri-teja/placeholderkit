{
  "name": "@placeholderkit/core",
  "version": "0.2.0",
  "description": "Placeholder images, avatars, logos and icons for React and HTML. Deterministic, offline SVG for prototypes, mockups and AI-built apps.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "sideEffects": [
    "./dist/placeholderkit.global.js"
  ],
  "files": [
    "dist",
    "llms.txt",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/placeholderkit.global.js",
  "jsdelivr": "./dist/placeholderkit.global.js",
  "bin": {
    "placeholderkit": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js",
      "require": "./dist/icons.cjs"
    },
    "./data": {
      "types": "./dist/data.d.ts",
      "import": "./dist/data.js",
      "require": "./dist/data.cjs"
    },
    "./global": "./dist/placeholderkit.global.js",
    "./llms.txt": "./llms.txt",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup && esbuild src/core/global.ts --bundle --minify --format=iife --global-name=PlaceholderKit --outfile=dist/placeholderkit.global.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "gallery": "esbuild scripts/render.ts --bundle --platform=node --external:@resvg/resvg-js --outfile=scripts/.render.cjs && node scripts/.render.cjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "prepublishOnly": "npm run typecheck && npm test",
    "site": "npm run build && node scripts/build-site.mjs"
  },
  "peerDependencies": {
    "lucide-react": ">=0.400.0",
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.24.2",
    "jsdom": "^25.0.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "placeholder",
    "placeholder-image",
    "placeholder-avatar",
    "avatar",
    "dummy-image",
    "mock-data",
    "mockup",
    "prototype",
    "fake-logo",
    "animal-avatar",
    "react",
    "svg",
    "identicon",
    "lorem-ipsum",
    "ai",
    "llm"
  ],
  "homepage": "https://sri-teja.github.io/placeholderkit/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sri-teja/placeholderkit.git"
  },
  "bugs": {
    "url": "https://github.com/sri-teja/placeholderkit/issues"
  }
}
